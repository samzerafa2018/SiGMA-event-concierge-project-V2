# Gemini is the default because it runs in the cloud and is lightweight locally.
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_THINKING_LEVEL=low

# Retry only temporary connection, rate-limit, and server failures.
LLM_MAX_ATTEMPTS=2
LLM_RETRY_DELAY_SECONDS=0.5

# Optional local Ollama settings. Change LLM_PROVIDER to ollama to use them.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
